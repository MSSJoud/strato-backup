# Backup policy for /home/ubuntu/work
# Keep code, notebooks, configs, text data, and project structure.
# Exclude the EarthScope2024 directory and large/generated data artifacts.

# Explicit project exclusion
EarthScope2024/

# Local tooling and caches
.agents/
.codex
.venv/
venv/
env/
.node-env/
node_modules/
.vscode/
.idea/
__pycache__/
.ipynb_checkpoints/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Temporary files and logs
*.pyc
*.pyo
*.pyd
*.log
*.tmp
*.swp
*.swo

# Secrets and machine-local files
.env
.env.*
.copernicus_dataspace_token
credentials.py
project_po/scripts/credentials_edl.json
*.pem
*.key
*.p12
*.pfx

# Archive/build artifacts
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.gz

# Large scientific and remote-sensing data
*.grib
*.grb
*.h5
*.hdf5
*.nc
*.npy
*.npz
*.mat
*.dem
*.dem.wgs84
*.vrt
*.SAFE
*.slc
*.rdr
*.int
*.off
*.cor
*.unw
*.conncomp
*.hgt
*.hdr
*.EOF
*.full
*.flat
*.crop
*.geo
*.dat
*.dir

# Large image and raster data
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff

# Geospatial/vector data exports
*.geojson
*.kml
*.kmz
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.ods

# Large model/binary artifacts
*.pt
*.pth
*.onnx
*.pkl
*.bin
*.so
*.dll
*.dylib
*.exe

# Local backup scratch space
repo_backups/

# Known large data/output folders
dem/
gmtsar_test_1/
gmtsar_test_2/
bologna_sbas_ps_2023/test_run/
project_po/data/
project_po/stack/topsStack_S1/inputs/
slc_stack_test_subset/
slc_test_2_subset/
slc_test_3_subset/
slc_test_subset/
slc_tops_test_subset/
topsout/
