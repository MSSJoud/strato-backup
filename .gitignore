# Code-only backup policy.
# Include all folders by default and ignore binary/data/runtime artifacts.

# Python and notebook runtime cache
__pycache__/
.ipynb_checkpoints/
*.pyc
*.pyo
*.pyd

# Virtual environments and local tooling
.venv/
venv/
env/
.node-env/
node_modules/
.vscode/
.idea/
.codex
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Common archive and package binaries
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.gz

