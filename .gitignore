# Backup policy.
# Prioritize source code, notes, configs, and reproducible experiment setup.
# Exclude regenerable data artifacts, raw input data, imagery, SAR intermediates,
# and local runtime files.

# Python and notebook runtime cache
__pycache__/
.ipynb_checkpoints/
*.pyc
*.pyo
*.pyd

# Virtual environments and local tooling
.venv/
venv/
env/
.node-env/
node_modules/
.vscode/
.idea/
.codex
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Common archive and package binaries
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.gz

# Scientific/remote sensing raw/intermediate binaries
*.grib
*.grb
*.mat
*.h5
*.hdf5
*.nc
*.npy
*.npz
*.dem
*.dem.wgs84
*.SAFE
*.rdr
*.slc
*.int
*.off
*.cor
*.unw
*.conncomp
*.hgt
*.hdr
*.EOF
*.dir
*.dat
*.bak
*.full
*.flat
*.crop
*.geo

# Scientific/geospatial vector input data
*.geojson
*.kml
*.kmz
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.ods

# Sidecar metadata for ignored remote-sensing binaries
*.rdr.xml
*.slc.xml
*.int.xml
*.off.xml
*.cor.xml
*.unw.xml
*.conncomp.xml
*.hgt.xml
*.bin.xml
*.xml

# Raster/vector imagery and binaries
*.tif
*.tiff
*.vrt
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Secrets and local credentials
.env
.env.*
.copernicus_dataspace_token
/credentials.py
/project_po/scripts/credentials_edl.json
.gitignore.backup.*
*.pem
*.key
*.p12
*.pfx

# Raw input/output folders to keep out of the GitHub backup
project_po/data/
project_po/stack/topsStack_S1/inputs/
slc_stack_test_subset/
slc_test_2_subset/
slc_test_3_subset/
slc_test_subset/
slc_tops_test_subset/
insar_mcmc/outputs_external_constraints/smap_matched_raw/
insar_mcmc/outputs_external_constraints_overlap2025/smap_matched_raw/
insar_mcmc/outputs_external_constraints_overlap2025/smap_matched_raw_fast/
mintpy-playbook/outputs/aoi_3_bologna_filtered/S1*

# Model and compiled binaries
*.pt
*.pth
*.onnx
*.pkl
*.bin
*.so
*.dll
*.dylib
*.exe
